{
  "name": "@containerbase/oxlint-plugin",
  "version": "0.0.0-PLACEHOLDER",
  "description": "containerbase oxlint plugin",
  "keywords": [
    "oxlint-plugin",
    "oxlint",
    "vitest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/containerbase/oxlint-plugin.git"
  },
  "license": "MIT",
  "author": "Michael Kriese <michael.kriese@mend.io>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "run-s prettier oxlint lint:types",
    "lint:types": "tsc",
    "lint-fix": "run-s prettier-fix oxlint-fix",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "prepack": "pnpm build",
    "prepare": "husky",
    "prettier": "prettier --cache -c -u \"**/*.*\"",
    "prettier-fix": "prettier --cache -w -u \"**/*.*\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxlint/plugins": "1.86.0"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/common-tags": "1.8.4",
    "@types/node": "24.19.1",
    "common-tags": "1.8.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "prettier-plugin-packagejson": "3.0.2",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "oxlint": ">=1.86.0"
  },
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=11.0.0"
  }
}
