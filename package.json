{
  "name": "@containerbase/oxlint-plugin",
  "version": "0.0.0-PLACEHOLDER",
  "description": "containerbase oxlint plugin",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "vitest"
  ],
  "license": "MIT",
  "author": "Michael Kriese <michael.kriese@mend.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/containerbase/oxlint-plugin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "run-s oxfmt oxlint lint:types",
    "lint:types": "tsc",
    "lint-fix": "run-s oxfmt-fix oxlint-fix",
    "oxfmt": "oxfmt --check",
    "oxfmt-fix": "oxfmt",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "prepack": "pnpm build",
    "prepare": "husky",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxlint/plugins": "1.89.0"
  },
  "devDependencies": {
    "@containerbase/semantic-release-pnpm": "1.4.3",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/common-tags": "1.8.4",
    "@types/node": "24.19.2",
    "common-tags": "1.8.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "oxlint": ">=1.86.0"
  },
  "engines": {
    "node": ">=24.10.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.16.0"
}
